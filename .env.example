# PawPal+ Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API key — required for AI Pet Assistant features
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the model used by the AI agent
# Defaults to gpt-4o-mini (fast, cost-efficient)
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo
PAWPAL_AI_MODEL=gpt-4o-mini

# Optional: confidence threshold below which responses are flagged for human review
# Default: 0.50
PAWPAL_CONFIDENCE_THRESHOLD=0.50

# Optional: path to log file (default: logs/pawpal_ai.log)
PAWPAL_LOG_FILE=logs/pawpal_ai.log
